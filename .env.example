# Database
DATABASE_URL=postgresql://qrprint_dev:@localhost:5432/qrprint_dev_db

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace_with_random_64_char_string

# File upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# Agent
AGENT_TOKEN_SECRET=replace_with_random_64_char_string

# Base URL (used for QR code generation)
BASE_URL=http://localhost:3000
